# AI Aptitude Mastery Coach - Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./aptitude_coach.db

# AI Tutor Service Configuration (gemini, openai, or local_rule)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys (Keep secret, never commit to git or expose to frontend)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Port
PORT=8000
